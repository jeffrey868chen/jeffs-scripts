#!/bin/bash
PASSWD_FILE="/etc/passwd"

regular_users=()
admin_users=()

BOLD='\033[1m'
LIGHT='\033[2m'
ITALIC='\033[3m'
UNDERLINE='\033[4m'
BLINK='\033[5m'
INVERT='\033[6m'
STRIKETHROUGH='\033[7m'

BLACK='\033[1;30m'
WARN='\033[1;6;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
PURPLE='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'

BLACKBG='\033[40m'
REDBG='\033[41m'
GREENBG='\033[42m'
YELLOWBG='\033[43m'
BLUEBG='\033[44m'
PURPLEBG='\033[45m'
CYANBG='\033[46m'
WHITEBG='\033[47m'

NC='\033[0m'

# The above values are ANSII codes to make aesthetically pleasing text (wow)!!

# Check if /etc/passwd exists and print an error message if it doesn't
if [[ ! -f "$PASSWD_FILE" ]]; then
    echo -e "${WARN}Error:${NC} /etc/passwd doesn't exist for sum reason, u should probably FIX IT."
    exit 1
fi

if [[ "$EUID" -ne 0 ]]; then
    echo -e "${WARN}Error:${NC} This script must be run as root (use sudo)."
    exit 1
fi

is_admin() {
    user="$1"
    id -nG "$user" 2>/dev/null | grep -qwE "sudo|wheel|adm"
}


echo "Enter REGULAR users (one per line)."
echo "Type DONE when finished."
echo " "
while true; do
    read -r user
    [[ "$user" == "DONE" ]] && break
    regular_users+=("$user")
done

echo
echo "Enter ADMIN users (one per line)."
echo "Type DONE when finished."
echo
while true; do
    read -r user
    [[ "$user" == "DONE" ]] && break
    admin_users+=("$user")
done

all_users=("${regular_users[@]}" "${admin_users[@]}")

# Begin running the actual script

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR MISSING USERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${regular_users[@]}"; do

    passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

    if [[ -z "$passwd_line" ]]; then
        echo -e "${WARN}[MISSING]${NC} User '$user' does NOT exist."
        echo
        continue
    fi

    echo -e "${GREEN}[FOUND]${NC} User '$user'"
    echo "  Full Entry: $passwd_line"

done

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR USERS WITH A BAD SHELL/UID${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${all_users[@]}"; do

    passwd_line=$(grep "^${user}:" "$PASSWD_FILE")
    [[ -z "$passwd_line" ]] && continue

    uid=$(echo "$passwd_line" | cut -d: -f3)
    shell=$(echo "$passwd_line" | cut -d: -f7)

    if [[ "$uid" -lt 1000 ]]; then
        echo -e "  ${WARN}[WARNING]${NC} '$user' UID is less than 1000 ($uid)"
    fi
    
    if [[ "$shell" == *"nologin"* || "$shell" == *"false"* ]]; then
        echo -e "  ${WARN}[WARNING]${NC} '$user' doesn't have an interactive shell ($shell)"
    fi

done

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR SHELLS IN /etc/shells${NC}"
echo -e "${BLUE}========================================${NC}"
echo

if grep -q "nologin" /etc/shells; then
    echo -e "${WARN}[WARNING]${NC} nologin is in /etc/shells"
fi

if grep -q "false" /etc/shells; then
    echo -e "${WARN}[WARNING]${NC} false is in /etc/shells"
fi

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR USERS WITH ADMIN PERMS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${regular_users[@]}"; do

if is_admin "$user"; then
    echo -e "  ${WARN}[WARNING]${NC} '$user' Regular user has admin privileges!"
else
    echo -e "  ${GREEN}[PASS]${NC} '$user' is not an administrator."
fi

echo

done

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR MISSING ADMINS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${admin_users[@]}"; do
passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

if [[ -z "$passwd_line" ]]; then
    echo -e "${WARN}[MISSING]${NC} Admin '$user' does NOT exist."
    echo
    continue
fi

done

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING THAT ALL ADMINS ARE ADMINS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${admin_users[@]}"; do
grep -q "^${user}:" "$PASSWD_FILE" || continue
passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

if is_admin "$user"; then
    echo -e "  ${GREEN}[PASS]${NC} '$user' has admin privileges."
else
    echo -e "  ${WARN}[WARNING]${NC} '$user' is listed as an admin but is NOT in sudo/wheel/adm."
fi

echo

done

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR ROOT IMPOSTERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

ROOT_IMPOSTERS=$(awk -F: '$3 == 0 && $1 != "root" {print $1}' /etc/passwd)

if [[ -n "$ROOT_IMPOSTERS" ]]; then
    echo -e "  ${WARN}[WARNING]${NC} There are root imposters:"
    echo "$ROOT_IMPOSTERS"
else
    echo -e "  ${GREEN}[PASS]${NC} No root imposters found."
fi

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING USER ENTRY FORMATS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${all_users[@]}"; do
    passwd_line=$(grep "^${user}:" "$PASSWD_FILE")
    [[ -z "$passwd_line" ]] && continue

    passwd=$(echo "$passwd_line" | cut -d: -f2)
    uid=$(echo "$passwd_line" | cut -d: -f3)
    gid=$(echo "$passwd_line" | cut -d: -f4)
    gecos=$(echo "$passwd_line" | cut -d: -f5)
    home=$(echo "$passwd_line" | cut -d: -f6)
    shell=$(echo "$passwd_line" | cut -d: -f7)


    if [[ "$passwd" != "x" ]]; then
        echo -e "${WARN}[WARNING]${NC} '$user' Password field is not set to 'x' ($passwd)"
    fi

    if [[ "$gecos" != ",,," ]]; then
        echo -e "${WARN}[WARNING]${NC} '$user' GECOS field is not set to ,,, ($gecos)"
    fi

    if [[ "$home" != "/home/$user" ]]; then
        echo -e "${WARN}[WARNING]${NC} '$user' Home directory is not /home/$user ($home)"
    fi
done

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR UNAUTHORIZED USERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

while IFS=: read -r username password uid gid comment home shell; do

    [[ "$username" == "root" ]] && continue
    grep -qx "$shell" /etc/shells 2>/dev/null || continue
    [[ "$uid" -lt 1000 ]] && continue

    if ! printf '%s\n' "${all_users[@]}" | grep -qx "$username"; then
        echo -e "${WARN}[UNAUTHORIZED]${NC} User '$username' has a valid shell but is not on the list."
        echo "  Full Entry: $username:$password:$uid:$gid:$comment:$home:$shell"

        if is_admin "$username"; then
            echo -e "  ${WARN}[CRITICAL]${NC} User has admin privileges!"
        fi

        echo
    fi

done < "$PASSWD_FILE"



CURRENT_USER="${SUDO_USER:-root}"

# Get normal human users (UID >= 1000), excluding the current user
awk -F: -v current="$CURRENT_USER" '
    $3 >= 1000 && $1 != current && $1 != "nobody" {
        print $1
    }
' /etc/passwd | while read -r user; do

    echo "========================================"
    echo "Updating: $user"
    echo "========================================"

    # Password aging:
    # minimum = 7 days
    # maximum = 90 days
    # warning = 14 days
    chage -m 7 -M 90 -W 14 "$user"

    # Change password
    echo "$user:CyberPatriot1!" | chpasswd

    echo
done

echo "Done."

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING SYSTEM USERS FOR VALID SHELLS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

while IFS=: read -r username password uid gid comment home shell; do

    # Ignore root
    [[ "$username" == "root" ]] && continue

    # Only check system users
    [[ "$uid" -ge 1000 ]] && continue

    # Check whether the shell is listed in /etc/shells
    if grep -qx "$shell" /etc/shells 2>/dev/null; then
        echo -e "${WARN}[WARNING]${NC} System user '$username' has a valid login shell."
        echo "  Full Entry: $username:$password:$uid:$gid:$comment:$home:$shell"
        echo
    fi

done < "$PASSWD_FILE"

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR CORRECT PASSWORD HASHES${NC}"
echo -e "${BLUE}========================================${NC}"
echo

while IFS=: read -r username hash _; do
    # Skip system accounts and non-shadow lines
    uid=$(id -u "$username" 2>/dev/null)
    [[ -z "$uid" || "$uid" -lt 1000 || "$username" == "nobody" ]] && continue

    if [[ "$hash" == \$y\$* ]]; then
        echo -e "  ${GREEN}[PASS]${NC} User '$username' is using yescrypt."
    else
        echo -e "  ${WARN}[WARNING]${NC} User '$username' is NOT using yescrypt."
    fi
done < /etc/shadow

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}AUDIT COMPLETE${NC}"
echo -e "${BLUE}========================================${NC}"
