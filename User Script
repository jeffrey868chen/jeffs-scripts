#!/bin/bash
PASSWD_FILE="/etc/passwd"
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
# The above values are ANSII codes to change color for aesthetic values (wow)!!
NC='\033[0m'
#NC resets all values back to default

# Check if /etc/passwd exists and print an error message if it doesn't
if [[ ! -f "$PASSWD_FILE" ]]; then
echo -e "${RED}Error:${NC} /etc/passwd doesn't exist for sum reason, u should probably FIX IT."
exit 1
fi

is_admin() {
    user="$1"
    id -nG "$user" | grep -qwE "sudo|wheel|adm"
    # The first part figures out what groups the user is in, while the second part greps for if the user is in the admin group
}

regular_users=()
admin_users=()

echo "Enter REGULAR users (one per line)."
echo "Type DONE when finished."
echo " "
while true; do
# Create a loop where the person can enter in the users until something breaks the loop
read -r user
[[ "$user" == "DONE" ]] && break
# If the user enters in DONE, then exit the loop
regular_users+=("$user")
# Otherwise, add that user to the list and continue
done

# Repeat the same thing but for admin users
echo
echo "Enter ADMIN users (one per line)."
echo "Type DONE when finished."
echo
while true; do
read -r user
[[ "$user" == "DONE" ]] && break
[[ "$user" == "root" ]] && continue
admin_users+=("$user")
done

all_users=("${regular_users[@]}" "${admin_users[@]}")

# Begin running the actual script

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING REGULAR USERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

for user in "${regular_users[@]}"; do
passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

if [[ -z "$passwd_line" ]]; then
    echo -e "${RED}[MISSING]${NC} User '$user' does NOT exist."
    echo
    continue
fi
# If the user's password line prints nothing, then print a warning

echo -e "${GREEN}[FOUND]${NC} User '$user'"
echo "  Full Entry: $passwd_line"
# Otherwise, print that the user has been found and move on

uid=$(echo "$passwd_line" | cut -d: -f3)
shell=$(echo "$passwd_line" | cut -d: -f7)

# Mark the third column of the password line as the user's id
# Mark the seventh column of the password line as the user's shell

if [[ "$uid" -lt 1000 ]]; then
    echo -e "  ${RED}[WARNING]${NC} UID is less than 1000 ($uid)"
fi

if [[ "$shell" == *"nologin"* || "$shell" == *"false"* ]]; then
    echo -e "  ${RED}[WARNING]${NC} User does not have an interactive shell ($shell)"
fi

if is_admin "$user"; then
    echo -e "  ${RED}[WARNING]${NC} Regular user has admin privileges!"
else
    echo -e "  ${GREEN}[PASS]${NC} User is not an administrator."
fi

echo

done
echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING ADMIN USERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo
for user in "${admin_users[@]}"; do
passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

if [[ -z "$passwd_line" ]]; then
    echo -e "${RED}[MISSING]${NC} Admin '$user' does NOT exist."
    echo
    continue
fi

uid=$(echo "$passwd_line" | cut -d: -f3)
shell=$(echo "$passwd_line" | cut -d: -f7)

if [[ "$uid" -lt 1000 ]]; then
    echo -e "  ${RED}[WARNING]${NC} UID is less than 1000 ($uid)"
fi

if [[ "$shell" == *"nologin"* || "$shell" == *"false"* ]]; then
    echo -e "  ${RED}[WARNING]${NC} Admin does not have an interactive shell ($shell)"
fi



ROOT_IMPOSTERS=$(awk -F: '$3 == 0 && $1 != "root" {print $1}' /etc/passwd)

if [[ -n "$ROOT_IMPOSTERS" ]]; then
    echo -e "  ${RED}[WARNING]${NC} There are root imposters:"
    echo "$ROOT_IMPOSTERS"
fi

echo -e "${GREEN}[FOUND]${NC} Admin '$user'"
echo "  Full Entry: $passwd_line"


if is_admin "$user"; then
    echo -e "  ${GREEN}[PASS]${NC} User has admin privileges."
else
    echo -e "  ${RED}[WARNING]${NC} User is listed as an admin but is NOT in sudo/wheel/adm."
fi

echo

done


for user in "${all_users[@]}"; do
passwd_line=$(grep "^${user}:" "$PASSWD_FILE")

user=$(echo "$passwd_line" | cut -d: -f1)
passwd=$(echo "$passwd_line" | cut -d: -f2)
uid=$(echo "$passwd_line" | cut -d: -f3)
gid=$(echo "$passwd_line" | cut -d: -f4)
gecos=$(echo "$passwd_line" | cut -d: -f5)
home=$(echo "$passwd_line" | cut -d: -f6)
shell=$(echo "$passwd_line" | cut -d: -f7)


if [[ "$passwd" != "x" ]]; then
    echo -e "${RED}[WARNING]${NC} Password field is not set to 'x' ($passwd)"
fi

if [[ "$gecos" != ",,," ]]; then
    echo -e "${RED}[WARNING]${NC} GECOS field is not set to ,,, ($gecos)"
fi

if [[ "$home" != "/home/$user" ]]; then
    echo -e "${RED}[WARNING]${NC} Home directory is not /home/$user ($home)"
fi

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING FOR UNAUTHORIZED USERS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

while IFS=: read -r username password uid gid comment home shell; do

    [[ "$username" == "root" ]] && continue
    grep -qx "$shell" /etc/shells 2>/dev/null || continue
    [[ "$uid" -lt 1000 ]] && continue

    if ! printf '%s\n' "${all_users[@]}" | grep -qx "$username"; then
        echo -e "${RED}[UNAUTHORIZED]${NC} User '$username' has a valid shell but is not on the list."
        echo "  Full Entry: $username:$password:$uid:$gid:$comment:$home:$shell"

        if is_admin "$username"; then
            echo -e "  ${RED}[CRITICAL]${NC} User has admin privileges!"
        fi

        echo
    fi

done < "$PASSWD_FILE"



CURRENT_USER="${SUDO_USER:-root}"

# Get normal human users (UID >= 1000), excluding the current user
awk -F: -v current="$CURRENT_USER" '
    $3 >= 1000 && $1 != current && $1 != "nobody" {
        print $1
    }
' /etc/passwd | while read -r user; do

    echo "========================================"
    echo "Updating: $user"
    echo "========================================"

    # Password aging:
    # minimum = 7 days
    # maximum = 90 days
    # warning = 14 days
    chage -m 7 -M 90 -W 14 "$user"

    # Change password
    echo "$user:CyberPatriot1!" | chpasswd

    echo
done

echo "Done."

echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}CHECKING SYSTEM USERS FOR VALID SHELLS${NC}"
echo -e "${BLUE}========================================${NC}"
echo

while IFS=: read -r username password uid gid comment home shell; do

    # Ignore root
    [[ "$username" == "root" ]] && continue

    # Only check system users
    [[ "$uid" -ge 1000 ]] && continue

    # Check whether the shell is listed in /etc/shells
    if grep -qx "$shell" /etc/shells 2>/dev/null; then
        echo -e "${RED}[WARNING]${NC} System user '$username' has a valid login shell."
        echo "  Full Entry: $username:$password:$uid:$gid:$comment:$home:$shell"
        echo
    fi

done < "$PASSWD_FILE"
echo
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}AUDIT COMPLETE${NC}"
echo -e "${BLUE}========================================${NC}"
