}

# ==================================================
# PAM HARDENING
# ==================================================
pam_hardening() {
    pam_warning || { echo "❌ PAM hardening cancelled."; return; }

    echo "[+] Hardening PAM (sudo-safe)..."
    install_if_missing libpam-modules libpam-pwquality

    cp /etc/pam.d/common-auth "$BACKUP_DIR/common-auth.bak"
    cp /etc/pam.d/common-password "$BACKUP_DIR/common-password.bak"

    cat > /etc/pam.d/common-auth <<EOF
# /etc/pam.d/common-auth - authentication settings common to all services
#
# This file is included from other service-specific PAM config files
# and should contain a list of the authentication modules that define
# the central authentication scheme for use on the system
# (e.g., /etc/shadow, LDAP, Kerberos, etc.).  The default is to use the
# traditional Unix authentication mechanisms.
#
# As of pam 1.0.1-6, this file is managed by pam-auth-update by default.
# To take advantage of this, it is recommended that you configure any
# local modules either before or after the default block, and use
# pam-auth-update to manage selection of other modules.  See
# pam-auth-update(8) for details.

# here are the per-package modules (the "Primary" block)
auth	required			pam_faillock.so preauth silent audit deny=5 unlock_time=900
auth	[success=2 default=ignore]	pam_unix.so
auth	[success=1 default=ignore]	pam_sss.so use_first_pass
auth	[default=die]			pam_faillock.so authfail audit deny=5 unlock_time=900
auth	sufficient			pam_faillock.so authsucc
# here's the fallback if no module succeeds
auth	requisite			pam_deny.so
# prime the stack with a positive return value if there isn't one already;
# this avoids us returning an error just because nothing sets a success code
# since the modules above will each just jump around
auth	required			pam_permit.so
auth	optional			pam_cap.so
EOF

    chmod 644 /etc/pam.d/common-auth

    cat > /etc/pam.d/common-password <<EOF
# As of pam 1.0.1-6, this file is managed by pam-auth-update by default.
# To take advantage of this, it is recommended that you configure any
# local modules either before or after the default block, and use
# pam-auth-update to manage selection of other modules.  See
# pam-auth-update(8) for details.

# here are the per-package modules (the "Primary" block)
password        requisite                       pam_pwquality.so retry=3 difok=5 minlen=8 dcredit=-1 ucredit=-1 lcredit=-1 ocredit=-1 minclass=4 maxrepeat=4 gecoscheck=1 enforce_for_root
password        [success=2 default=ignore]      pam_unix.so obscure use_authtok try_first_pass yescrypt remember=10
password        sufficient                      pam_sss.so use_authtok
# here's the fallback if no module succeeds
password        requisite                       pam_deny.so
# prime the stack with a positive return value if there isn't one already;
# this avoids us returning an error just because nothing sets a success code
# since the modules above will each just jump around
password        required                        pam_permit.so
# and here are more per-package modules (the "Additional" block)
password        optional        pam_gnome_keyring.so
# end of pam-auth-update config
EOF

    chmod 644 /etc/pam.d/common-password

    echo "✅ PAM hardening complete!"
    echo "🔐 TEST NOW (other terminal): sudo -k && sudo true"
}

# change the config for login.defs
login_defs_hardening() {
    echo "[+] Hardening login.defs..."
    cp /etc/login.defs "$BACKUP_DIR/login.defs.bak"

    set_def() {
        grep -q "^$1" /etc/login.defs && \
        sed -i "s|^$1.*|$1 $2|" /etc/login.defs || \
        echo "$1 $2" >> /etc/login.defs
    }

    set_def PASS_MAX_DAYS 90
    set_def PASS_MIN_DAYS 7
    set_def PASS_WARN_AGE 14
    set_def ENCRYPT_METHOD YESCRYPT
    set_def LOG_UNKFAIL_ENAB yes
    set_def FAILLOG_ENAB yes
    set_def LOG_OK_LOGINS yes

    UID_MIN=$(awk '/^UID_MIN/{print $2}' /etc/login.defs)
    UID_MIN=${UID_MIN:-1000}

    while IFS=: read -r u _ uid _ _ _ shell; do
        [[ "$u" == "root" ]] && continue
        [[ "$u" == "$MAIN_USER" ]] && continue
        [[ "$uid" -lt "$UID_MIN" ]] && continue
        [[ "$shell" =~ (nologin|false)$ ]] && continue
        chage -m 7 -M 90 -W 14 "$u"
    done < /etc/passwd

    echo "✅ login.defs hardened!"
}

# ==================================================
# SSH HARDENING
# ==================================================
ssh_hardening() {
    echo "[+] Hardening SSH..."
    install_if_missing openssh-server
    cp /etc/ssh/sshd_config "$BACKUP_DIR/sshd_config.bak"

    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
    sed -i 's/^#\?PermitEmptyPasswords.*/PermitEmptyPasswords no/' /etc/ssh/sshd_config
    sed -i 's/^#\?X11Forwarding.*/X11Forwarding no/' /etc/ssh/sshd_config
    sed -i 's/^#\?UsePAM.*/UsePAM yes/' /etc/ssh/sshd_config

    systemctl restart sshd
    echo "✅ SSH hardened!"
}

# ==================================================
# USER AUDIT (INTEGRATED)
# ==================================================
users_audit() {
    echo "[+] Running user audit..."

    NON_HUMAN="root|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|gnats|nobody|systemd-network|systemd-resolve|syslog|_apt"
    ADMIN_GROUPS="sudo|wheel|admin"

    printf "%-15s %-6s %-25s %-12s %-8s %-13s %-12s %-8s %-8s %-8s %-s\n" \
    "Username" "UID" "Shell" "LikelyHuman" "Admin" "PwStatus" "LastChange" "MinDays" "MaxDays" "WarnAge" "Groups"

    printf "%-15s %-6s %-25s %-12s %-8s %-13s %-12s %-8s %-8s %-8s %-s\n" \
    "---------------" "------" "-------------------------" "------------" "--------" "-------------" "------------" "--------" "--------" "--------" "------"

    while IFS=: read -r username _ uid _ _ _ shell; do
        [[ "$username" =~ ^($NON_HUMAN)$ ]] && human="No" || human="Yes"
        id -nG "$username" 2>/dev/null | grep -Eqw "($ADMIN_GROUPS)" && admin="Yes" || admin="No"

        pwinfo=$(passwd -S "$username" 2>/dev/null || true)
        set -- $pwinfo

        groups=$(id -nG "$username" 2>/dev/null | tr ' ' ',')

        printf "%-15s %-6s %-25s %-12s %-8s %-13s %-12s %-8s %-8s %-8s %-s\n" \
        "$username" "$uid" "$shell" "$human" "$admin" "${2:-N/A}" "${3:-N/A}" "${4:-N/A}" "${5:-N/A}" "${6:-N/A}" "$groups"
    done < /etc/passwd

    echo "✅ User audit complete!"
}

