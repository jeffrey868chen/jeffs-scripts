install_if_missing() {
    for pkg in "$@"; do
        if ! dpkg -s "$pkg" >/dev/null 2>&1; then
            apt-get update -qq
            apt-get install -y "$pkg"
        fi
    done
}

system_updates() {
    echo "[+] Running system updates..."
    apt update
    apt full-upgrade -y
    apt autoremove --purge -y
    apt autoclean
    echo "System updates complete!"
}


auto_updates() {
    echo "[+] Enabling automatic updates..."
    install_if_missing unattended-upgrades apt-listchanges

    cat > /etc/apt/apt.conf.d/20auto-upgrades <<EOF
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

    dpkg-reconfigure -f noninteractive unattended-upgrades
    echo "Automatic updates enabled!"
}

# harden ufw
ufw_hardening() {
    echo "[+] Configuring UFW firewall..."
    install_if_missing ufw

    ufw allow OpenSSH
    ufw default deny incoming
    ufw default allow outgoing
    ufw logging on
    ufw --force enable

    echo "UFW hardened!"
}

file_permissions() {

    chmod 644 /etc/passwd
    chmod 640 /etc/shadow
    chmod 644 /etc/group
    chmod 640 /etc/gshadow
    
    chown root:root /etc/passwd /etc/group
    chown root:shadow /etc/shadow /etc/gshadow
    

    chmod 440 /etc/sudoers
    chown root:root /etc/sudoers
    
    chmod 600 /etc/ssh/sshd_config
    chown root:root /etc/ssh/sshd_config
    chmod 600 /etc/crontab
    chown root:root /etc/crontab
    
    if [[ -d /etc/cron.d ]]; then
      chmod 700 /etc/cron.d
      chown root:root /etc/cron.d
    fi
    

    chmod 644 /etc/fstab /etc/sysctl.conf /etc/login.defs
    chown root:root /etc/fstab /etc/sysctl.conf /etc/login.defs
    

    chmod 755 /var/log
    chown root:root /var/log
    
    for log in /var/log/auth.log /var/log/syslog; do
      if [[ -f "$log" ]]; then
        chmod 640 "$log"
        chown root:adm "$log"
      fi
    done
    

    chmod 755 /boot
    chown root:root /boot
    
    chmod 600 /boot/vmlinuz-* /boot/initrd.img-* 2>/dev/null || true
    

    for dir in /home/*/.ssh; do
      if [[ -d "$dir" ]]; then
        chmod 700 "$dir"
        chmod 600 "$dir"/* 2>/dev/null || true
        chown -R "$(basename "$(dirname "$dir")")":"$(basename "$(dirname "$dir")")" "$dir"
      fi
    done
    

    echo "🔍 Checking for world-writable files in /etc:"
    find /etc -type f -perm -0002 -print
    
    echo "Permission hardening complete."
}


